# Butler runtime
BUTLER_ENVIRONMENT=development
BUTLER_LOG_LEVEL=info

# Service connection strings
BUTLER_POSTGRES_URL=postgres://butler:butler-dev-password@localhost:5432/butler?sslmode=disable
BUTLER_REDIS_URL=redis://localhost:6379/0

# Optional settings-at-rest encryption for Sprint 8 config overrides.
# When unset, Butler stores secret overrides in plaintext and logs a startup warning.
# Provider OAuth always requires this key and has no plaintext fallback.
BUTLER_SETTINGS_ENCRYPTION_KEY=

# Model providers
BUTLER_MODEL_PROVIDER=openai
BUTLER_OPENAI_API_KEY=
BUTLER_OPENAI_MODEL=gpt-4o-mini
BUTLER_OPENAI_BASE_URL=https://api.openai.com/v1
BUTLER_OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
BUTLER_OPENAI_TRANSPORT_MODE=ws-first
BUTLER_OPENAI_CODEX_MODEL=gpt-5.1-codex
BUTLER_OPENAI_CODEX_BASE_URL=https://chatgpt.com/backend-api
BUTLER_GITHUB_COPILOT_MODEL=gpt-4o
BUTLER_ANTIGRAVITY_MODEL=gemini-3.8-flash-tiered
BUTLER_ANTIGRAVITY_MAXIMUM_OUTPUT_TOKENS=0
BUTLER_OPENAI_TIMEOUT_SECONDS=60
BUTLER_MEMORY_PROFILE_LIMIT=20
BUTLER_MEMORY_EPISODIC_LIMIT=3
BUTLER_MEMORY_SCOPE_ORDER=session,user,global
# Required for remote extension mode (comma-separated bearer tokens)
BUTLER_EXTENSION_API_TOKENS=
BUTLER_SINGLE_TAB_TRANSPORT_MODE=dual
BUTLER_SINGLE_TAB_RELAY_HEARTBEAT_TTL_SECONDS=90

# Tool services
BUTLER_TOOL_BROKER_ADDR=127.0.0.1:10090
BUTLER_TOOL_BROWSER_NODE_BINARY=node
BUTLER_TOOL_BROWSER_SCRIPT_PATH=apps/tool-browser/scripts/browser_runtime.mjs
BUTLER_TOOL_BROWSER_LOCAL_ORCHESTRATOR_URL=http://127.0.0.1:8080
BUTLER_TOOL_BROWSER_LOCAL_BROWSER_BRIDGE_URL=http://127.0.0.1:29115
BUTLER_TOOL_BROWSER_LOCAL_ROLLOUT_MODE=remote_preferred
BUTLER_TOOL_BROWSER_LOCAL_DISPATCH_MODE=orchestrator_relay
BUTLER_TOOL_BROWSER_LOCAL_REQUEST_TIMEOUT_SECONDS=60
BUTLER_BROWSER_BRIDGE_ORCHESTRATOR_URL=http://127.0.0.1:8080
BUTLER_BROWSER_BRIDGE_CONTROL_ADDR=127.0.0.1:29115
BUTLER_BROWSER_BRIDGE_REQUEST_TIMEOUT_SECONDS=15
BUTLER_WEBFETCH_SELF_HOSTED_BASE_URL=
BUTLER_WEBFETCH_JINA_BASE_URL=https://r.jina.ai/http://
BUTLER_WEBFETCH_JINA_AUTH_TOKEN=
BUTLER_WEBFETCH_PLAIN_HTTP_ENABLED=true
BUTLER_DOCTOR_CONTAINER_TARGETS=

# Telegram adapter
BUTLER_TELEGRAM_BOT_TOKEN=
BUTLER_TELEGRAM_ALLOWED_CHAT_IDS=
BUTLER_TELEGRAM_BASE_URL=https://api.telegram.org
BUTLER_TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Tool registry placeholder
BUTLER_AUTONOMY_MODE=mode_1
BUTLER_ACTION_MANDATE_ID=
# Deployment operator policy: identical in Orchestrator/Broker. Finite defaults;
# empty models means unknown cost and inference denied. Subscription basis needs
# explicit operator choice plus an adapter that does not buy credits/overage.
BUTLER_EXECUTION_BUDGET_POLICY_JSON=
# Google AI Pro example (native fixed Gemini3.8 Flash):
# BUTLER_EXECUTION_BUDGET_POLICY_JSON={"models":{"antigravity:gemini-3.8-flash-tiered":{"basis":"subscription_no_overage"}}}
# Private service authentication: mount a generated secret file; never put its
# contents in model settings, tool args or an environment example.
BUTLER_ACTION_AUTHORITY_TOKEN_SOURCE=../.secrets/action-authority.token
BUTLER_ACTION_AUTHORITY_TOKEN_FILE=
BUTLER_ACTION_CONTEXT_URL=http://127.0.0.1:8080/internal/action-context
BUTLER_TOOL_REGISTRY_PATH=configs/tools.json
BUTLER_TOOL_DEFAULT_TARGET=local
# Conservative initial context allowance; includes encoded input/tool schemas.
BUTLER_CONTEXT_BUDGET_TOKENS=65536

# Optional owner-control scope for Web approval decisions (operator environment/file only).
# Generate at least 32 bytes on the lab; match OWNER_ID to the saved web session owner.
BUTLER_OWNER_CONTROL_OWNER_ID=
BUTLER_OWNER_CONTROL_TOKEN_FILE=
# BUTLER_OWNER_CONTROL_TOKEN=  # Alternative to TOKEN_FILE; never configure both.

# Optional reviewed HTTP-JSON extensions (empty disables installation/runtime).
# Pin the operator-deployed profile artifact/source; manifests never fetch code.
BUTLER_EXTENSION_PROFILES_JSON=
BUTLER_EXTENSION_RUNTIME_TOKEN_SOURCE=../.secrets/extension-runtime.token
BUTLER_EXTENSION_RUNTIME_TOKEN_FILE=
BUTLER_EXTENSION_CONTROL_URL=

# Optional reviewed procedural catalog.
# Optional deploy/docker-compose.memory-read.yml: fixed Broker DATA reads.
BUTLER_MEMORY_READ_ENABLED=false
BUTLER_SKILLS_ENABLED=false
BUTLER_SKILL_CONTROL_URL=
# The optional deploy/docker-compose.extensions.yml supplies private service URLs.

# Optional pure delimited-to-JSON converters; no arbitrary executable language.
# Migration052, skills051 and persistent privacy anchor are prerequisites.
BUTLER_CONVERTERS_ENABLED=false
BUTLER_CONVERTER_PROFILE_JSON=
BUTLER_CONVERTER_RUNTIME_TARGET=unix:///run/butler-converter/runtime.sock
BUTLER_CONVERTER_RUNTIME_TOKEN_SOURCE=../.secrets/converter-runtime.token
BUTLER_CONVERTER_RUNTIME_TOKEN_FILE=
BUTLER_CONVERTER_CONTROL_URL=
# deploy/docker-compose.converters.yml supplies network-none Unix socket topology.

# Optional bounded research delegation; both core and Broker require opt-in.
# Optional Broker-only destination cap; missing class adds no cap, [] denies all.
# Example: {"http":["api.example.com"],"browser":["*.example.com"]}
BUTLER_NETWORK_ALLOWLISTS_JSON=
# PostgreSQL migrations057/061 and the existing private authority token are required.
BUTLER_DELEGATION_ENABLED=false
BUTLER_DELEGATION_MAX_PARALLEL=1
BUTLER_DELEGATION_CONTROL_URL=
# Broker destination when enabled: http://orchestrator:8080/internal/delegation
# Distinct reviewed developer role; requires converters, delegation and053/054.
BUTLER_CONVERTER_DELEGATION_ENABLED=false
BUTLER_CONVERTER_DELEGATION_CONTROL_URL=
# Broker destination: http://orchestrator:8080/internal/converter-delegation
# Explicit opt-in overlays: delegation.yml then converter-delegation.yml;
# converter-delegation also requires docker-compose.converters.yml.
# Independent generative memory worker; owner-proved PG control also starts disabled.
BUTLER_MEMORY_MODEL_JOBS_ENABLED=false
# Only the structural exact-source diagnostic; production consumers have separate gates.
BUTLER_MEMORY_MODEL_QUOTE_PROBE_ENABLED=false
# Candidate proposals additionally need a qualified code-owned release gate.
BUTLER_MEMORY_MODEL_CANDIDATES_ENABLED=false
# Verified extractive task compaction; independent owner policy/control required.
BUTLER_MEMORY_SUMMARY_CONSUMER_ENABLED=false
# Owner-reviewed immutable consolidation; independent qualification and policy.
BUTLER_MEMORY_CONSOLIDATION_CONSUMER_ENABLED=false

# Optional agent-created schedules; enable in both services with the Compose overlay.
BUTLER_SCHEDULES_ENABLED=false
# Tool Broker only: fixed private Orchestrator control route.
BUTLER_SCHEDULES_CONTROL_URL=http://orchestrator:8080/internal/schedules
