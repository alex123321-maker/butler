  "description": "Search or navigate a public same-origin GET form with named ordinary text fields. Use forms metadata from the current observation to choose selector and field names. Compiles a GET URL without click, input, submit or page handlers; POST forms, hidden/password/file fields, credential state and any prior input/private draft are refused. Requires current session, observation_version and exact expected_url. Network freezes again after navigation. This proves a GET observation only, never a remote write.",
  "tool_class": "browser",
  "input_schema_json": "{\"type\":\"object\",\"required\":[\"browser_session_id\",\"selector\",\"fields\",\"observation_version\",\"expected_url\"],\"properties\":{\"browser_session_id\":{\"type\":\"string\"},\"selector\":{\"type\":\"string\"},\"fields\":{\"type\":\"array\",\"maxItems\":32,\"items\":{\"required\":[\"name\",\"value\"],\"properties\":{\"value\":{\"type\":\"string\",\"maxLength\":4096},\"name\":{\"minLength\":1,\"maxLength\":128,\"type\":\"string\"}},\"additionalProperties\":false,\"type\":\"object\"}},\"observation_version\":{\"type\":\"integer\"},\"expected_url\":{\"type\":\"string\"},\"timeout\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":30000}},\"additionalProperties\":false}",
