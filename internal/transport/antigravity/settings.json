{
  "toolPermission": "strict",
  "artifactReviewPolicy": "asks-for-review",
  "allowNonWorkspaceAccess": false,
  "enableTerminalSandbox": true,
  "useG1Credits": false,
  "enableTelemetry": false,
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": [
      "command(*)",
      "unsandboxed(*)",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ]
  }
}
