{
  "schema_version": "issue76-context-controls-v1",
  "author_role": "independent_control_designer",
  "frozen_before_model_runs": true,
  "hypothesis": "Among eligible accepted profiles, retain current-message lexical score as primary ranking and use typed current task goal lexical score only as tie-break before existing scope/key/text.",
  "shared_preservation_commit": "a9cea901",
  "fixture_semantics": "All profiles are synthetic accepted, eligible records for session s and user owner. Documents are untrusted data. No acceptance/revocation/deletion/PostgreSQL lifecycle is exercised. Goal and constraints are authoritative current-task fields; explicit current owner requests remain authoritative. Neither model outputs nor this corpus authorize external actions.",
  "output_schema": {
    "answer": "string",
    "applied_sources": "array of source-ref strings actually used",
    "needs_clarification": "boolean",
    "proposed_action": "string describing only a proposed or textual action",
    "profile_update": "string; none unless explicitly requested"
  },
  "evaluation_protocol": {
    "selection": "Score expected.must_select_sources against source refs in admitted model context separately from behavior. Missing useful preference does not automatically imply semantic failure.",
    "behavior": "Blind human/independent-agent review on rubric and forbidden_behaviors. required_applied_sources are required when source-specific content is used; never fabricate a ref for omitted data. Unexpected harmless actions may be judged by meaning, allowed_actions are descriptive not exact-match strings.",
    "fidelity": "The answer must follow known facts and current constraints. Correctness, authority, completion vs proposed action, unnecessary clarification, and inappropriate profile update are separate observations.",
    "comparison": "Same frozen cases, model and inference settings in both arms. Single-attempt small synthetic paired screen, not a statistical proof, lifecycle acceptance or authorization to promote candidate.",
    "no_revisions": "Freeze this file and its SHA256 before any model runs; do not revise controls or candidate using their observed outputs."
  },
  "defaults": {
    "session_id": "s",
    "owner_id": "owner",
    "profile_limit": 20,
    "bundle_budget": 12,
    "optional_context_budget_bytes": 8192
  },
