# Render TEST_DOMAIN after verifying DNS and obtaining its public certificate.
server {
    listen 80;
    listen [::]:80;
    server_name TEST_DOMAIN;
    access_log off;
    location /.well-known/acme-challenge/ {
        root /var/lib/butler-browser-eval-acme;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name TEST_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/TEST_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/TEST_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # Error logs must not retain secret-bearing URLs/request metadata either.
    error_log /dev/null crit;
    client_max_body_size 4k;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location / {
        proxy_pass http://127.0.0.1:18097;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}
