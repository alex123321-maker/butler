{
  "name": "butler-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"app/**/*.{css,vue}\" \"features/**/*.{css,vue}\" \"entities/**/*.vue\" \"shared/**/*.vue\" \"pages/**/*.vue\" \"assets/css/**/*.css\" --allow-empty-input",
    "typecheck": "vue-tsc --noEmit",
    "preview": "nuxt preview",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "simple-git": {
      ".": "4.0.1",
      "@simple-git/argv-parser": "2.0.1"
    }
  }
}
